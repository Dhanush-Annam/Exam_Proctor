# Gemini Vision API Key for review.py
GEMINI_API_KEY=your_gemini_api_key_here

# Webhook Callback Verification Secret (Shared with Express backend)
WEBHOOK_SECRET=your_webhook_secret_key_here

# Redis Connection Configuration
# Set REDIS_URL for connection strings (e.g. Upstash) or separate HOST/PORT for local Docker
REDIS_URL=rediss://default:password@host.upstash.io:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Supabase Storage Configuration (for cloud screenshot storage in production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET=proctor-screenshots

# Backend URL
BACKEND_URL=https://your-backend-url.com