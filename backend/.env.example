# Backend Port Configuration
PORT=3001

# JWT token signature secret
JWT_SECRET=your_super_secret_key

# Webhook Callback Verification Secret (Shared with AI service)
WEBHOOK_SECRET=your_webhook_secret_key_here

# Service Integration URLs
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Local Fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_proctor
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Supabase Storage Configuration (for generating secure signed URLs)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET=proctor-screenshots

# Single connection string with SSL configuration
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
