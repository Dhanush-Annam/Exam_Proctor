# ==============================================================================
# Exam Proctor Workspace Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings (backend/.env)
# ------------------------------------------------------------------------------
PORT=3001
JWT_SECRET=your_super_secret_key
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Local Fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_proctor
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Single connection string with SSL configuration (for cloud databases like Neon/Supabase)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------------------------------------------
# Frontend Settings (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# AI Service Settings (ai-service/.env)
# ------------------------------------------------------------------------------
# Gemini Vision API Key for review.py
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Storage Configuration (for cloud screenshot storage in production)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your_supabase_service_role_or_anon_key
# SUPABASE_BUCKET=proctor-screenshots